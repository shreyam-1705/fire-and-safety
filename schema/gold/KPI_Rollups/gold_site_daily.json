{
  "table": "gold_site_daily",
  "layer": "gold",
  "grain": "one row per site per day",
  "partitionBy": ["date"],
  "columns": [
    { "name": "date", "type": "string", "key": "PK" },
    { "name": "organization_id", "type": "string", "key": "FK" },
    { "name": "site_id", "type": "string", "key": "PK" },
    { "name": "active_alarms", "type": "int64" },
    { "name": "active_faults", "type": "int64" },
    { "name": "monitored_devices", "type": "int64" },
    { "name": "fleet_health_score", "type": "double" },
    { "name": "active_disablements", "type": "int64" },
    { "name": "smoke_detector_count", "type": "int64" },
    { "name": "horn_strobe_count", "type": "int64" },
    { "name": "mcp_count", "type": "int64" },
    { "name": "multi_sensor_count", "type": "int64" },
    { "name": "ror_heat_count", "type": "int64" },
    { "name": "daily_total_alarms", "type": "int64" },
    { "name": "daily_total_faults", "type": "int64" },
    { "name": "daily_self_tests", "type": "int64" },
    { "name": "system_online_pct", "type": "double" },
    { "name": "total_online_controllers", "type": "int64" },
    { "name": "total_degraded_controllers", "type": "int64" },
    { "name": "total_offline_controllers", "type": "int64" },
    { "name": "nfpa72_drift_pass_rate", "type": "double" },
    { "name": "nac_audibility_pass_rate", "type": "double" },
    { "name": "strobe_sync_pass_rate", "type": "double" },
    { "name": "battery_runtime_hours", "type": "double" }
  ]
}