{
  "title": "Manual Call Point Payload",
  "description": "Schema for manual call points (MCP-*). No self_verify support.",
  "type": "object",
  "required": [
    "schema_version",
    "message_type",
    "event_id",
    "timestamp",
    "device_id",
    "current_state",
    "fault_code",
    "standard_metrics",
    "sensor_metrics"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "message_type": {
      "type": "string",
      "enum": [
        "HEARTBEAT",
        "STATE_CHANGE",
        "FAULT_DETECTED",
        "ALARM_TRIGGERED"
      ]
    },
    "event_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "device_id": {
      "type": "string"
    },
    "current_state": {
      "type": "string",
      "enum": [
        "NORMAL",
        "ALARM",
        "TROUBLE",
        "DISABLED",
        "OFFLINE"
      ]
    },
    "fault_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "standard_metrics": {
      "type": "object",
      "required": [
        "is_test_mode",
        "loop_voltage_dc"
      ],
      "properties": {
        "is_test_mode": {
          "type": "boolean"
        },
        "loop_voltage_dc": {
          "type": "number"
        }
      }
    },
    "sensor_metrics": {
      "type": "object",
      "required": [
        "is_activated",
        "tamper_switch"
      ],
      "properties": {
        "is_activated": {
          "type": "boolean"
        },
        "tamper_switch": {
          "type": "boolean"
        }
      }
    }
  }
}