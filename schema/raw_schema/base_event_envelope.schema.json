{
  "title": "Base Event Envelope",
  "description": "Common fields every device payload must have.",
  "type": "object",
  "required": [
    "schema_version",
    "message_type",
    "event_id",
    "timestamp",
    "device_id",
    "current_state",
    "fault_code",
    "standard_metrics",
    "sensor_metrics"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0", "1.1"]
    },
    "message_type": {
      "type": "string",
      "enum": ["HEARTBEAT", "STATE_CHANGE", "FAULT_DETECTED", "ALARM_TRIGGERED"]
    },
    "event_id": {
      "type": "string",
      "pattern": "^evt-[0-9]{8}-[0-9]{5}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "device_id": {
      "type": "string",
      "minLength": 1
    },
    "current_state": {
      "type": "string",
      "enum": ["NORMAL", "ALARM", "TROUBLE", "DISABLED", "OFFLINE"]
    },
    "fault_code": {
      "type": ["string", "null"]
    },
    "standard_metrics": {
      "type": "object",
      "required": ["is_test_mode", "loop_voltage_dc"],
      "properties": {
        "is_test_mode": { "type": "boolean" },
        "loop_voltage_dc": { "type": "number" },
        "self_verify_passed": { "type": "boolean" }
      }
    },
    "sensor_metrics": {
      "type": "object"
    }
  }
}
